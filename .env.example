# 제주데이터허브 API 주소 (데이터허브 상세 화면에서 복사)
TRAFFIC_HOTSPOT_URL=https://open.jejudatahub.net/api/proxy/YOUR_KEY/_j3e6tr0r11otp0rt11b3rc06jj90e1t
# 구글 지도(선택): Google Cloud 콘솔 > API 및 서비스 > 'Maps JavaScript API' 사용 설정 후 발급한 API 키
#   결제 계정 연결이 필요하며, 키의 '웹사이트 제한'에 앱 주소(예: http://localhost:8501/*)를 넣으세요.
#   없으면 기본 지도로 표시됩니다.
# GOOGLE_MAPS_API_KEY=
# 로컬 LLM (Ollama). 기본값 gemma3:4b  -> 설치: ollama pull gemma3:4b
# OLLAMA_MODEL=gemma3:4b
# OLLAMA_URL=http://127.0.0.1:11434
# 선택: CSV 폴더, DB 위치
# TRAFFIC_RAW_DIR=reference   (기본값: 프로젝트의 reference 폴더)
# TRAFFIC_DB_PATH=data/jeju_traffic.sqlite
# --- AI 서비스 선택 (기본: 이 PC의 Ollama). 외부 서비스를 쓰면 질문과 분석 결과 요약이 외부로 전송됩니다.
# LLM_PROVIDER=ollama        # ollama | openrouter | openai | anthropic  (키가 있으면 자동 선택)
# LLM_MODEL=                 # 비우면 서비스별 기본 모델. OpenRouter 예: openai/gpt-4o-mini, anthropic/claude-haiku-5.5
# OPENROUTER_API_KEY=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# OpenRouter 개인정보 설정: 기본값은 '저장·학습 금지 + 데이터 무보관(ZDR) 제공자만'. LLM_PRIVACY=off 로 끌 수 있음(비권장)
# LLM_PROVIDER_ONLY=azure    # 쓸 제공자를 고정(예: azure, amazon-bedrock). 쉼표로 여러 개
